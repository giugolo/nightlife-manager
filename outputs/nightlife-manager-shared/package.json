{
  "name": "dioniso",
  "private": true,
  "version": "0.13.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "preview": "npm run dev",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "e2e": "node scripts/e2e.mjs",
    "dev:frontend": "vite",
    "doctor": "node scripts/doctor.mjs",
    "typecheck": "tsc --noEmit",
    "test:run": "vitest run",
    "verify": "npm run lint && npm run typecheck && npm run test:run && npm run build",
    "e2e:browser": "playwright test",
    "setup": "npm ci && npx --no-install playwright install chromium && npm run doctor",
    "test:shutdown": "node scripts/check-emulator-shutdown.mjs",
    "preview:production": "vite preview"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/sora": "^5.2.8",
    "firebase": "^12.6.0",
    "lucide-react": "^0.559.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-router-dom": "^7.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.15",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.2.0",
    "vitest": "^3.0.2",
    "firebase-tools": "15.20.0"
  },
  "engines": {
    "node": ">=24.21.0 <25"
